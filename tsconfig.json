{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist", "sourceMap": true, "declaration": true
  },
  "include": ["src/**/*.ts"]
}
